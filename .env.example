# Copy to .env and fill in your own values. Never commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

COHERE_API_KEY=
EMBEDDING_MODEL=embed-english-light-v3.0
EMBEDDING_DIM=384

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Recommended on Vercel: Crawl4AI Cloud uses a hosted browser; keep this key server-side only.
# Get a key from https://crawl4ai.com/ (check the current free credit allowance and limits).
CRAWL4AI_API_KEY=
CRAWL4AI_API_TIMEOUT_SECONDS=90

# Optional alternative for local Crawl4AI connecting to a remote Chromium CDP endpoint.
# Used only when CRAWL4AI_API_KEY is blank. Local-browser mode requires:
# pip install crawl4ai==0.9.5 && crawl4ai-setup
CRAWL4AI_CDP_URL=
CRAWL4AI_TIMEOUT_SECONDS=25
