# Copy to .env and fill in your own values. Never commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

COHERE_API_KEY=
EMBEDDING_MODEL=embed-english-light-v3.0
EMBEDDING_DIM=384

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional for serverless deployments that cannot bundle/run local Chromium.
# Leave blank for local Playwright Chromium (run crawl4ai-setup after pip install).
CRAWL4AI_CDP_URL=
CRAWL4AI_TIMEOUT_SECONDS=25
